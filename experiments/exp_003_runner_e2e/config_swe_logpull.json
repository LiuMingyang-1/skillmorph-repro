{
  "name": "swe_batch1_logpull",
  "dataset": {
    "name": "swe_skills_bench",
    "tasks": [
      "tdd-workflow-batch1"
    ],
    "runs_per_task": 1
  },
  "method": {
    "name": "copy"
  },
  "skill": {
    "dir": "../../datasets/swe_skills_bench/skills"
  },
  "executor": {
    "agent_cmd": "echo  | base64 -d > src/calculator.py && echo  | base64 -d > /tmp/agent_trajectory.jsonl",
    "agent_timeout_sec": 300,
    "eval_timeout_sec": 300,
    "trajectory_container_path": "/tmp/agent_trajectory.jsonl"
  },
  "output": {
    "dir": "out_logpull"
  }
}